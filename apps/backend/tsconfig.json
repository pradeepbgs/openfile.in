{
   "compilerOptions": {
      "lib": [
         "es2021"
      ],
      "target": "esnext",
      "module": "esnext",
      "moduleResolution": "bundler",
      "outDir": "./build",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "sourceMap": true,
      "skipLibCheck": true,
      "noEmitOnError": false,
      "strictNullChecks": true,
      "baseUrl": ".",
      "paths": {
         "@/*": ["./src/*"]
      }
   }
}